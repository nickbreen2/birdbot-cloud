generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Agent {
  id          String   @id @default(cuid())
  clerkUserId String
  name        String
  model       String
  traits      Json
  focusAreas  String[]
  channels    String[]
  status      String   @default("incubating")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId])
}
