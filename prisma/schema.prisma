generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Subscription {
  id                     String   @id @default(cuid())
  clerkUserId            String   @unique
  stripeCustomerId       String   @unique
  stripeSubscriptionId   String   @unique
  stripePriceId          String
  status                 String
  currentPeriodEnd       DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([clerkUserId])
  @@index([stripeCustomerId])
}

model McpConnection {
  id          String    @id @default(cuid())
  clerkUserId String    @unique
  userToken   String    @unique
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
}

model CloudSession {
  id        String   @id @default(cuid())
  userToken String
  project   String
  sessionId String   @unique
  summary   String?
  createdAt DateTime
  syncedAt  DateTime @default(now())

  @@index([userToken, project])
}

model CloudDecision {
  id        String   @id @default(cuid())
  userToken String
  project   String
  sessionId String?
  decision  String
  reasoning String?
  createdAt DateTime
  syncedAt  DateTime @default(now())

  @@index([userToken, project])
  @@index([sessionId])
}

model CloudProject {
  id        String   @id @default(cuid())
  userToken String
  name      String
  createdAt DateTime @default(now())

  @@unique([userToken, name])
  @@index([userToken])
}

model ProjectBrief {
  id        String   @id @default(cuid())
  userToken String
  project   String
  brief     String
  updatedAt DateTime @updatedAt

  @@unique([userToken, project])
  @@index([userToken])
}
