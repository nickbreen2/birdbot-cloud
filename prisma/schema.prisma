generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Agent {
  id          String   @id @default(cuid())
  clerkUserId String
  name        String
  model       String
  traits      Json
  focusAreas  String[]
  channels    String[]
  status      String   @default("incubating")
  errorReason String?
  serverId    String?
  containerId String?
  hostPort    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  server      Server?  @relation(fields: [serverId], references: [id])

  @@index([clerkUserId])
}

model Server {
  id              String   @id @default(cuid())
  hetznerServerId Int      @unique
  ip              String
  region          String   @default("us-east")
  containerCount  Int      @default(0)
  capacityLimit   Int      @default(6)
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agents          Agent[]

  @@index([status])
}

model Subscription {
  id                     String   @id @default(cuid())
  clerkUserId            String   @unique
  stripeCustomerId       String   @unique
  stripeSubscriptionId   String   @unique
  stripePriceId          String
  status                 String
  currentPeriodEnd       DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([clerkUserId])
  @@index([stripeCustomerId])
}

model McpConnection {
  id          String    @id @default(cuid())
  clerkUserId String    @unique
  userToken   String    @unique
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())
}
