# ── Neon Database ────────────────────────────────────────────
# Get from Neon dashboard → Connection Details
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Clerk Auth ──────────────────────────────────────────────
# Get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard
# Routes Clerk API calls through your own domain — fixes iOS Safari ITP blocking
NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk

# ── Stripe Billing ───────────────────────────────────────────
# Get from https://dashboard.stripe.com (use test mode keys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create 3 subscription products in Stripe dashboard, then paste the Price IDs:
STRIPE_STARTER_PRICE_ID=price_...   # $19/mo
STRIPE_PRO_PRICE_ID=price_...       # $29/mo
STRIPE_POWER_PRICE_ID=price_...     # $49/mo

# ── App URL ─────────────────────────────────────────────────
# Local dev:      http://localhost:3000
# Production:     https://birdbot.ai
# Set this in Vercel environment variables to https://birdbot.ai before deploying.
# Used by: Stripe checkout redirects, OG image base URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
