# ── Neon Database ────────────────────────────────────────────
# Get from Neon dashboard → Connection Details
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Clerk Auth ──────────────────────────────────────────────
# Get from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# ── Stripe Billing ───────────────────────────────────────────
# Get from https://dashboard.stripe.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create 2 subscription products in Stripe dashboard, then paste the Price IDs:
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...

# ── Anthropic ───────────────────────────────────────────────
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Trigger.dev ─────────────────────────────────────────────
# Get from https://cloud.trigger.dev → API keys
TRIGGER_SECRET_KEY=tr_dev_...

# ── Telegram ─────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=...
TELEGRAM_BOT_USERNAME=your_bot_username
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=...

# ── Google OAuth ──────────────────────────────────────────────
# Get from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Generate with: openssl rand -hex 32
GOOGLE_OAUTH_STATE_SECRET=...
# Generate with: openssl rand -base64 32  (must decode to exactly 32 bytes)
GOOGLE_TOKEN_ENCRYPTION_KEY=...

# ── App URL ──────────────────────────────────────────────────
# Local dev: http://localhost:3000  |  Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Admin bypass ─────────────────────────────────────────────
# Comma-separated emails that always have full access regardless of subscription
ADMIN_EMAILS=you@example.com
